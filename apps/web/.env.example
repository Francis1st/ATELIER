# Public site URL used for metadata / sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only set these when the iOS app is actually live on the App Store
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_APP_STORE_LIVE=false

# iPhone waitlist — leave disabled until a real endpoint exists
# NEXT_PUBLIC_WAITLIST_ENABLED=true
# NEXT_PUBLIC_WAITLIST_ENDPOINT=https://example.com/api/waitlist

# AI Curated Cover — must point at a server-side proxy (never put model API keys here)
# The proxy should accept multipart form (image, prompt, category, requestId) and
# return image/* or JSON { imageBase64, mimeType?, model? }. Enforce auth, size limits,
# rate limits, and cost caps on the server before enabling in production.
# NEXT_PUBLIC_AI_COVER_ENABLED=true
# NEXT_PUBLIC_AI_COVER_ENDPOINT=https://your-worker.example/api/curated-cover
